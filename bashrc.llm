# Intel Arc Pro B70 inference workflow — sourced from ~/.bashrc
# Relocatable: LLM_DIR is the folder containing this file.
LLM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LLM_DIR
# if/then (not "[ -f ] && ."): the && form returns 1 when env.sh is missing,
# which breaks `ssh host cmd` if this is the last line of .bashrc.
if [ -f "$LLM_DIR/env.sh" ]; then . "$LLM_DIR/env.sh"; fi

# vLLM XPU (best at concurrency). The vLLM checkpoint is dense-only, so these
# aliases force LLM_MODEL_OVERRIDE=dense even when env.sh selects "moe".
# (Model download and benchmarking are not aliased: run
#  ./models/download_model.sh  and  ./benchmarks/bench_vllm.sh  directly.)
alias b70-vllm="LLM_MODEL_OVERRIDE=dense $LLM_DIR/serve_vllm.sh"        # MTP4 + patches (~78 t/s)
alias b70-vllm-claude="LLM_MODEL_OVERRIDE=dense VLLM_MTP_N=0 VLLM_PREFIX_CACHING=1 $LLM_DIR/serve_vllm.sh"  # cache on, MTP off
alias b70-vllm-cache="LLM_MODEL_OVERRIDE=dense VLLM_PREFIX_CACHING=1 $LLM_DIR/serve_vllm.sh"  # MTP4 + cache, no v5 (unstable on overlap)
alias b70-vllm-claude-mtp="LLM_MODEL_OVERRIDE=dense VLLM_MTP_N=4 VLLM_PREFIX_CACHING=1 VLLM_MIXED_SPLIT=1 $LLM_DIR/serve_vllm.sh"  # MTP4 + cache + v5
alias b70-vllm-fullctx="LLM_MODEL_OVERRIDE=dense VLLM_MAX_MODEL_LEN=262144 VLLM_MAX_NUM_SEQS=1 VLLM_MAX_BATCHED_TOKENS=4096 VLLM_GPU_MEM_UTIL=0.95 VLLM_MTP_N=0 VLLM_PREFIX_CACHING=0 $LLM_DIR/serve_vllm.sh"  # full 262k ctx, MTP off
alias b70-vllm-logs='docker logs -f vllm-b70'
alias b70-vllm-stop='docker rm -f vllm-b70'

# llama.cpp SYCL — stops vLLM first (single card); the only llama.cpp backend here.
# Plain aliases use the model selected by the LLM_MODEL line in env.sh.
# The -dense / -moe aliases force one for a single run.
alias b70-sycl="$LLM_DIR/serve_sycl.sh"  # true 262k, one slot, ~25 t/s
alias b70-sycl-dense="LLM_MODEL_OVERRIDE=dense $LLM_DIR/serve_sycl.sh"
alias b70-sycl-moe="LLM_MODEL_OVERRIDE=moe $LLM_DIR/serve_sycl.sh"
alias b70-sycl-stop='docker rm -f llama-sycl'
alias b70-sycl-logs='docker logs -f llama-sycl'

# Show the model selected in env.sh (re-sources it, so edits apply immediately)
alias b70-model='. "$LLM_DIR/env.sh" && printf "LLM_MODEL=%s (%s)\n" "$LLM_MODEL" "$LLM_MODEL_LABEL"'

# Show which backend is currently serving
alias b70-what="$LLM_DIR/status.sh"
