{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/qwen#off",
  "plugin": [
    ["opencode-models-discovery@latest", {
      "smartModelName": true
    }]
  ],
  "compaction": {
    "auto": true
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "allow"
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM",
      "options": {
        "baseURL": "http://127.0.0.1:8001/v1"
      },
      "models": {
        "qwen": {
          "name": "Qwen3.8",
          "cost": {
            "input": 0.2,
            "output": 2.5,
            "cache_read": 0.09,
            "cache_write": 0
          },
          "limit": {
            "context": 196608,
            "output": 32768
          },
          "variants": {
            "off": {
              "chat_template_kwargs": {
                "enable_thinking": false
              }
            },
            "low": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "low"
              }
            },
            "medium": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "medium"
              }
            },
            "xhigh": {
              "chat_template_kwargs": {
                "enable_thinking": true,
                "reasoning_effort": "xhigh"
              }
            }
          }
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "modelsDiscovery": {
          "enabled": true,
          "smartModelName": true
        }
      },
      "models": {}
    },
    "openrouter": {
      "options": {
        "model": "openrouter/free"
      }
    }
  }
}
